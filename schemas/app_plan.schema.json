{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "app_plan",
  "type": "object",
  "properties": {
    "athlete_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "authority": {
      "const": "HQ"
    },
    "week_start": {
      "type": "string",
      "format": "date"
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "workout_type": {
            "enum": [
              "RUN_EASY",
              "RUN_LONG",
              "RUN_THRESHOLD",
              "RUN_INTERVAL",
              "RUN_HILLS",
              "RUN_BRICK",
              "BIKE_AEROBIC",
              "BIKE_ENDURANCE",
              "BIKE_SWEETSPOT",
              "BIKE_THRESHOLD",
              "BIKE_VO2",
              "BIKE_BRICK",
              "SWIM_TECHNIQUE",
              "SWIM_ENDURANCE",
              "SWIM_CSS",
              "SWIM_OPEN_WATER",
              "STRENGTH_GENERAL",
              "STRENGTH_FULLBODY",
              "STRENGTH_LOWER",
              "STRENGTH_UPPER",
              "MOBILITY",
              "RECOVERY",
              "CROSSFIT"
            ]
          },
          "duration_min": {
            "type": "number",
            "minimum": 5,
            "maximum": 480
          },
          "intensity": {
            "enum": [
              "EASY",
              "MODERATE",
              "HARD"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "locked": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "workout_type",
          "duration_min",
          "intensity",
          "purpose",
          "locked"
        ]
      },
      "maxItems": 21
    }
  },
  "additionalProperties": false,
  "required": [
    "athlete_id",
    "version",
    "authority",
    "week_start",
    "sessions"
  ]
}
