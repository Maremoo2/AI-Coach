{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source_fact",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "HQ_PLAN",
        "DEVICE",
        "ATHLETE_REPORT",
        "CORRECTION"
      ]
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "source",
    "recorded_at",
    "kind",
    "supersedes",
    "payload"
  ],
  "additionalProperties": false
}
