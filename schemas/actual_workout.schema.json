{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "actual_workout",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "athlete_id": {
      "type": "string",
      "minLength": 1
    },
    "source_fact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_min": {
      "type": "number",
      "minimum": 0
    },
    "execution": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "rpe": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        {
          "type": "null"
        }
      ]
    },
    "quality": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "volume": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "enum": [
                "M",
                "KM",
                "REPS",
                "KG_REPS"
              ]
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "session_id",
    "athlete_id",
    "source_fact_ids",
    "started_at",
    "duration_min",
    "execution",
    "rpe",
    "quality",
    "volume"
  ],
  "additionalProperties": false
}
