{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "app_checkin",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "athlete_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "DONE",
        "PARTIAL",
        "SKIPPED"
      ]
    },
    "duration_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 480
    },
    "rpe": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        {
          "type": "null"
        }
      ]
    },
    "quality": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "pain": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        {
          "type": "null"
        }
      ]
    },
    "recovery": {
      "enum": [
        "NORMAL",
        "POOR",
        "UNKNOWN"
      ]
    },
    "energy": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "athlete_id",
    "session_id",
    "observed_at",
    "status",
    "duration_min",
    "rpe",
    "quality",
    "pain",
    "recovery",
    "energy",
    "notes"
  ]
}
