{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "app_goal",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "athlete_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "metric": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "baseline": {
      "type": "number",
      "minimum": -10000,
      "maximum": 10000
    },
    "target": {
      "type": "number",
      "minimum": -10000,
      "maximum": 10000
    },
    "direction": {
      "enum": [
        "INCREASE",
        "DECREASE"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "value": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "additionalProperties": false,
        "required": [
          "date",
          "value",
          "source"
        ]
      }
    },
    "status": {
      "enum": [
        "ACTIVE",
        "PAUSED",
        "COMPLETED"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "athlete_id",
    "title",
    "metric",
    "unit",
    "baseline",
    "target",
    "direction",
    "start_date",
    "target_date",
    "measurements",
    "status"
  ]
}
