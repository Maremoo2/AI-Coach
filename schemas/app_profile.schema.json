{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "app_profile",
  "type": "object",
  "properties": {
    "athlete_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "weekly_minutes": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 2400
        },
        {
          "type": "null"
        }
      ]
    },
    "max_session_minutes": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 5,
          "maximum": 480
        },
        {
          "type": "null"
        }
      ]
    },
    "available_days": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      },
      "uniqueItems": true
    },
    "preferred_workouts": {
      "type": "array",
      "items": {
        "enum": [
          "RUN_EASY",
          "RUN_LONG",
          "RUN_THRESHOLD",
          "RUN_INTERVAL",
          "RUN_HILLS",
          "RUN_BRICK",
          "BIKE_AEROBIC",
          "BIKE_ENDURANCE",
          "BIKE_SWEETSPOT",
          "BIKE_THRESHOLD",
          "BIKE_VO2",
          "BIKE_BRICK",
          "SWIM_TECHNIQUE",
          "SWIM_ENDURANCE",
          "SWIM_CSS",
          "SWIM_OPEN_WATER",
          "STRENGTH_GENERAL",
          "STRENGTH_FULLBODY",
          "STRENGTH_LOWER",
          "STRENGTH_UPPER",
          "MOBILITY",
          "RECOVERY",
          "CROSSFIT"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "blocked_workouts": {
      "type": "array",
      "items": {
        "enum": [
          "RUN_EASY",
          "RUN_LONG",
          "RUN_THRESHOLD",
          "RUN_INTERVAL",
          "RUN_HILLS",
          "RUN_BRICK",
          "BIKE_AEROBIC",
          "BIKE_ENDURANCE",
          "BIKE_SWEETSPOT",
          "BIKE_THRESHOLD",
          "BIKE_VO2",
          "BIKE_BRICK",
          "SWIM_TECHNIQUE",
          "SWIM_ENDURANCE",
          "SWIM_CSS",
          "SWIM_OPEN_WATER",
          "STRENGTH_GENERAL",
          "STRENGTH_FULLBODY",
          "STRENGTH_LOWER",
          "STRENGTH_UPPER",
          "MOBILITY",
          "RECOVERY",
          "CROSSFIT"
        ]
      },
      "uniqueItems": true
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "string",
      "maxLength": 2000
    },
    "coaching_tone": {
      "enum": [
        "CALM",
        "DIRECT",
        "ENCOURAGING"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "athlete_id",
    "name",
    "timezone",
    "weekly_minutes",
    "max_session_minutes",
    "available_days",
    "preferred_workouts",
    "blocked_workouts",
    "equipment",
    "limitations",
    "coaching_tone"
  ]
}
